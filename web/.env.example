# Copy to .env.local. Never commit .env.local — it's gitignored.
#
# Deliberately NOT prefixed with NEXT_PUBLIC_: these are read only in server
# components and server actions, so the API key never reaches the browser
# bundle. See the root .env.example and README "Secrets & security" section.

OPSPILOT_API_BASE_URL=http://localhost:8000
OPSPILOT_API_KEY=your_api_key_here
