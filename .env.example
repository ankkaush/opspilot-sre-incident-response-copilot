# Copy this file to .env and fill in real values. Never commit .env — it's
# gitignored, and this file (.env.example) must only ever contain placeholders.

# Postgres connection used by the API and by Alembic migrations. The
# password here is a local-only throwaway for the docker-compose dev
# container, not a real secret — replace it if you ever expose this
# database beyond localhost.
DATABASE_URL=postgresql+psycopg://opspilot:local-dev-only-not-a-secret@localhost:5432/opspilot

# Shared secret required in the X-API-Key header on every protected route.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_api_key_here

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# debug | info | warning | error
LOG_LEVEL=info

# dev | test | prod — informational only, does not change security behavior.
ENV=dev

# Required to run the agent loop (v0.1 Phase 2+). Not needed for Phase 1's
# inspection endpoints or for the test suite, which injects a fake model
# client and never calls the real API.
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Deterministic, code-enforced ceilings on one investigation run — never
# decided by the model itself. See blueprint pushback #6.
AGENT_MAX_STEPS=8
AGENT_MAX_COST_USD=0.20
